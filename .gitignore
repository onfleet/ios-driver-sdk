# Mac OS
.DS_Store

# CocoaPods — restored by `pod install`
Pods

# Build output (regenerated)
DerivedData
.derived-data-log-*

# Debug symbols emitted into the xcframework by -create-xcframework. Not published:
# 0.43 and earlier shipped without them, and they are large. Keep in sync with
# Deploy/SampleApp/gitignore in the monorepo, which overwrites this file on deploy.
dSYMs/

# CocoaPods generates the workspace on `pod install`
SampleApp.xcworkspace

# User-specific Xcode state
SampleApp.xcodeproj/project.xcworkspace/xcuserdata
SampleApp.xcodeproj/xcuserdata

# NOTE: SampleApp.xcodeproj and Derived/ are intentionally committed. They are produced
# by `tuist generate` at deploy time so integrators can open and build the sample with
# just `pod install` — no Tuist required. Regenerate them from Project.swift if needed.
