{"hierarchy":{"paths":[["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DriverContext"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Access shared instance using ","type":"text"},{"code":"DriverContext.shared","type":"codeVoice"},{"text":". Before host app starts using ","type":"text"},{"code":"shared","type":"codeVoice"},{"text":" it","type":"text"},{"text":" ","type":"text"},{"text":"must intitate SDK early at application launching sequence. See","type":"text"},{"text":" ","type":"text"},{"code":"DriverContext.initSDK(with:environment:app:loggers:)","type":"codeVoice"},{"text":". To check if SDK has been already initialized you can","type":"text"},{"text":" ","type":"text"},{"text":"check ","type":"text"},{"code":"DriverContext.isInitialized","type":"codeVoice"},{"text":" property.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"DriverContext provides access to following core services:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"authentication and accounts"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"After the SDK is initialized it is a good practice to check if ","type":"text"},{"type":"codeVoice","code":"SessionManaging.isAuthenticated"},{"text":" ","type":"text"},{"text":"returns true. In that case the UI may show main driver\/tasks flow, otherwise a login UI should be shown.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"codeVoice","code":"SessionManaging"},{"text":" for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"driver and tasks"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"If driver is successfuly authenticated host app can use ","type":"text"},{"type":"codeVoice","code":"DriverManagerProtocol"},{"text":" protocol to hook up UI","type":"text"},{"text":" ","type":"text"},{"text":"to important observable properties such as active task, list of tasks, duty status, etc.","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"type":"codeVoice","code":"DriverManagerProtocol"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"locations"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"When driver is on duty the SDK tracks user’s location and continously uploads it to the server thus the SDK","type":"text"},{"text":" ","type":"text"},{"text":"requires location permissions ","type":"text"},{"inlineContent":[{"type":"text","text":"Always"}],"type":"strong"},{"text":" and precise location must be ","type":"text"},{"inlineContent":[{"type":"text","text":"on"}],"type":"strong"},{"text":" when on duty.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"codeVoice","code":"LocationManaging"},{"text":" for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"attachments uploads"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"An active task can be supplemented with image attachments. These however don’t block task completion","type":"text"},{"text":" ","type":"text"},{"text":"so they are uploaded on background after the task is completed. Host app can observe these events","type":"text"},{"text":" ","type":"text"},{"text":"and update UI accordingly. See ","type":"text"},{"type":"codeVoice","code":"AttachmentsManaging"},{"text":" for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"data fetching and observing"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"While SDK synchronizes data automatically on the background, sometimes there is a need to allow users","type":"text"},{"text":" ","type":"text"},{"text":"to refetch data, for example if there is an error or lost of connection. Also data fetching event can be observed","type":"text"},{"text":" ","type":"text"},{"text":"and updated UI accordingly. See ","type":"text"},{"type":"codeVoice","code":"DriverContext.refetchData(completion:)"},{"text":" and methods","type":"text"},{"text":" ","type":"text"},{"text":"in dedicated section below for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"push notifications"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"Onfleet SDK uses push notfications to present important events in UI such as new tasks assigned or to","type":"text"},{"text":" ","type":"text"},{"text":"sync some data on the background. It is responsibility of host app to check in app delegate if incoming","type":"text"},{"text":" ","type":"text"},{"text":"push notification is owned by Onfleet using ","type":"text"},{"type":"codeVoice","code":"DriverContext.canHandleRemoteNotification(_:)"},{"text":" and if yes it","type":"text"},{"text":" ","type":"text"},{"text":"must be forwarded to the SDK using ","type":"text"},{"type":"codeVoice","code":"DriverContext.handleRemoteNotification(userInfo:)"},{"text":". Please don’t forget to forward","type":"text"},{"text":" ","type":"text"},{"text":"also APN device token using ","type":"text"},{"type":"codeVoice","code":"DriverContext.setRemoteNotificationsDeviceToken(_:)"},{"text":" ","type":"text"},{"text":"See methods in dedicated section below for more info.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/onfleetdriver\/drivercontext"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Main SDK object that provides access to all services.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext"},"kind":"symbol","metadata":{"externalID":"s:13OnfleetDriver0B7ContextC","title":"DriverContext","modules":[{"name":"OnfleetDriver"}],"navigatorTitle":[{"text":"DriverContext","kind":"identifier"}],"role":"symbol","symbolKind":"class","roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DriverContext"}]},"topicSections":[{"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/init()"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/attachments","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/dataState","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/deviceId","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/driverManager","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/dutyStatusManager","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/fetchingState","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/isDataStale","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/isInitialized","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/legacyDriverManager","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverConte