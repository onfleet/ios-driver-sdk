":"Type-Properties","title":"Type Properties"},{"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/InitializationError"],"generated":true,"title":"Enumerations","anchor":"Enumerations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DriverContext","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Access shared instance using ","type":"text"},{"code":"DriverContext.shared","type":"codeVoice"},{"text":". Before host app starts using ","type":"text"},{"code":"shared","type":"codeVoice"},{"text":" it","type":"text"},{"text":" ","type":"text"},{"text":"must intitate SDK early at application launching sequence. See","type":"text"},{"text":" ","type":"text"},{"code":"DriverContext.initSDK(with:environment:app:loggers:)","type":"codeVoice"},{"text":". To check if SDK has been already initialized you can","type":"text"},{"text":" ","type":"text"},{"text":"check ","type":"text"},{"code":"DriverContext.isInitialized","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"DriverContext provides access to following core services:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"authentication and accounts"}]},{"type":"text","text":" -"},{"type":"text","text":" "},{"type":"text","text":"After the SDK is initialized it is a good practice to check if "},{"code":"SessionManaging.isAuthenticated","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"returns true. In that case the UI may show main driver\/tasks flow, otherwise a login UI should be shown."},{"type":"text","text":" "},{"type":"text","text":"See "},{"code":"SessionManaging","type":"codeVoice"},{"type":"text","text":" for more info."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"driver and tasks"}]},{"type":"text","text":" -"},{"type":"text","text":" "},{"type":"text","text":"If driver is successfuly authenticated host app can use "},{"code":"DriverManagerProtocol","type":"codeVoice"},{"type":"text","text":" protocol to hook up UI"},{"type":"text","text":" "},{"type":"text","text":"to important observable properties such as active task, list of tasks, duty status, etc."},{"type":"text","text":" "},{"type":"text","text":"see "},{"code":"DriverManagerProtocol","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"locations"}]},{"type":"text","text":" -"},{"type":"text","text":" "},{"type":"text","text":"When driver is on duty the SDK tracks user’s location and continously uploads it to the server thus the SDK"},{"type":"text","text":" "},{"type":"text","text":"requires location permissions "},{"type":"strong","inlineContent":[{"type":"text","text":"Always"}]},{"type":"text","text":" and precise location must be "},{"type":"strong","inlineContent":[{"type":"text","text":"on"}]},{"type":"text","text":" when on duty."},{"type":"text","text":" "},{"type":"text","text":"See "},{"code":"LocationManaging","type":"codeVoice"},{"type":"text","text":" for more info."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"attachments uploads"}]},{"text":" -","type":"text"},{"type":"text","text":" "},{"type":"text","text":"An active task can be supplemented with image attachments. These however don’t block task completion"},{"type":"text","text":" "},{"type":"text","text":"so they are uploaded on background after the task is completed. Host app can observe these events"},{"text":" ","type":"text"},{"text":"and update UI accordingly. See ","type":"text"},{"type":"codeVoice","code":"AttachmentsManaging"},{"text":" for more info.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"data fetching and observing"}]},{"type":"text","text":" -"},{"type":"text","text":" "},{"type":"text","text":"While SDK synchronizes data automatically on the background, sometimes there is a need to allow users"},{"type":"text","text":" "},{"type":"text","text":"to refetch data, for example if there is an error or lost of connection. Also data fetching event can be observed"},{"type":"text","text":" "},{"type":"text","text":"and updated UI accordingly. See "},{"code":"DriverContext.refetchData(completion:)","type":"codeVoice"},{"type":"text","text":" and methods"},{"type":"text","text":" "},{"type":"text","text":"in dedicated section below for more info."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"push notifications"}]},{"type":"text","text":" -"},{"type":"text","text":" "},{"type":"text","text":"Onfleet SDK uses push notfications to present important events in UI such as new tasks assigned or to"},{"type":"text","text":" "},{"type":"text","text":"sync some data on the background. It is responsibility of host app to check in app delegate if incoming"},{"type":"text","text":" "},{"type":"text","text":"push notification is owned by Onfleet using "},{"code":"DriverContext.canHandleRemoteNotification(_:)","type":"codeVoice"},{"type":"text","text":" and if yes it"},{"type":"text","text":" "},{"type":"text","text":"must be forwarded to the SDK using "},{"code":"DriverContext.handleRemoteNotification(userInfo:)","type":"codeVoice"},{"type":"text","text":". Please don’t forget to forward"},{"type":"text","text":" "},{"type":"text","text":"also APN device token using "},{"code":"DriverContext.setRemoteNotificationsDeviceToken(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"See methods in dedicated section below for more info."}]}]}],"type":"orderedList"}]}],"references":{"doc://onfleetdriversdk.OnfleetDriver/documentation/OnfleetDriver/DriverContext/handleRemoteNotification(userInfo:)":{"kind":"symbol","abstract":[{"type":"text","text":"Handle remote notifications passed from app delegate."}],"identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/handleRemoteNotification(userInfo:)","type":"topic","url":"\/documentation\/onfleetdriver\/drivercontext\/handleremotenotification(userinfo:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handleRemoteNotification"},{"kind":"text","text":"("},{"kind":"externalParam","text":"userInfo"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:s11AnyHashableV","kind":"typeIdentifier","text":"AnyHashable"},{"kind":"text","text":" : "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"])"}],"title":"handleRemoteNotification(userInfo:)","role":"symbol"},"doc://onfleetdriversdk.OnfleetDriver/documentation/OnfleetDriver/DriverContext/initSDK(with:environment:app:loggers:)":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/initSDK(with:environment:app:loggers:)","type":"topic","url":"\/documentation\/onfleetdriver\/drivercontext\/initsdk(with:environment:app:loggers:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initSDK"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13OnfleetDriver17ApplicationConfigV","kind":"typeIdentifier","text":"Applica