ocumentation\/OnfleetDriver\/DriverContext\/tasksManager"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/canHandleRemoteNotification(userInfo:)","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/handleRemoteNotification(_:completionHandler:)","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/handleRemoteNotification(userInfo:)","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/initSDK(with:environment:app:loggers:)","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/processPendingAttachments()","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/refetchData(completion:)","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/setRemoteNotificationsDeviceToken(_:)"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/FetchDataHandler"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/shared"]},{"title":"Enumerations","anchor":"Enumerations","generated":true,"identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/InitializationError"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DriverContext","kind":"identifier"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Access shared instance using "},{"type":"codeVoice","code":"DriverContext.shared"},{"text":". Before host app starts using ","type":"text"},{"type":"codeVoice","code":"shared"},{"type":"text","text":" it"},{"text":" ","type":"text"},{"type":"text","text":"must intitate SDK early at application launching sequence. See"},{"type":"text","text":" "},{"code":"DriverContext.initSDK(with:environment:app:loggers:)","type":"codeVoice"},{"text":". To check if SDK has been already initialized you can","type":"text"},{"type":"text","text":" "},{"text":"check ","type":"text"},{"code":"DriverContext.isInitialized","type":"codeVoice"},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"text":"DriverContext provides access to following core services:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"authentication and accounts","type":"text"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"After the SDK is initialized it is a good practice to check if ","type":"text"},{"type":"codeVoice","code":"SessionManaging.isAuthenticated"},{"type":"text","text":" "},{"type":"text","text":"returns true. In that case the UI may show main driver\/tasks flow, otherwise a login UI should be shown."},{"type":"text","text":" "},{"type":"text","text":"See "},{"code":"SessionManaging","type":"codeVoice"},{"text":" for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"driver and tasks","type":"text"}],"type":"strong"},{"type":"text","text":" -"},{"type":"text","text":" "},{"type":"text","text":"If driver is successfuly authenticated host app can use "},{"type":"codeVoice","code":"DriverManagerProtocol"},{"type":"text","text":" protocol to hook up UI"},{"text":" ","type":"text"},{"text":"to important observable properties such as active task, list of tasks, duty status, etc.","type":"text"},{"type":"text","text":" "},{"text":"see ","type":"text"},{"type":"codeVoice","code":"DriverManagerProtocol"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"locations","type":"text"}]},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"When driver is on duty the SDK tracks user’s location and continously uploads it to the server thus the SDK","type":"text"},{"text":" ","type":"text"},{"text":"requires location permissions ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Always"}]},{"text":" and precise location must be ","type":"text"},{"inlineContent":[{"type":"text","text":"on"}],"type":"strong"},{"text":" when on duty.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"code":"LocationManaging","type":"codeVoice"},{"text":" for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"attachments uploads"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"An active task can be supplemented with image attachments. These however don’t block task completion","type":"text"},{"text":" ","type":"text"},{"text":"so they are uploaded on background after the task is completed. Host app can observe these events","type":"text"},{"text":" ","type":"text"},{"text":"and update UI accordingly. See ","type":"text"},{"code":"AttachmentsManaging","type":"codeVoice"},{"text":" for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"data fetching and observing"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"While SDK synchronizes data automatically on the background, sometimes there is a need to allow users","type":"text"},{"text":" ","type":"text"},{"text":"to refetch data, for example if there is an error or lost of connection. Also data fetching event can be observed","type":"text"},{"text":" ","type":"text"},{"text":"and updated UI accordingly. See ","type":"text"},{"code":"DriverContext.refetchData(completion:)","type":"codeVoice"},{"text":" and methods","type":"text"},{"text":" ","type":"text"},{"text":"in dedicated section below for more info.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"push notifications","type":"text"}],"type":"strong"},{"text":" -","type":"text"},{"text":" ","type":"text"},{"text":"Onfleet SDK uses push notfications to present important events in UI such as new tasks assigned or to","type":"text"},{"text":" ","type":"text"},{"text":"sync some data on the background. It is responsibility of host app to check in app delegate if incoming","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"push notification is owned by Onfleet using "},{"type":"codeVoice","code":"DriverContext.canHandleRemoteNotification(_:)"},{"type":"text","text":" and if yes it"},{"type":"text","text":" "},{"type":"text","text":"must be forwarded to the SDK using "},{"type":"codeVoice","code":"DriverContext.handleRemoteNotification(userInfo:)"},{"type":"text","text":". Please don’t forget to forward"},{"type":"text","text":" "},{"type":"text","text":"also APN device token using "},{"type":"codeVoice","code":"DriverContext.setRemoteNotificationsDeviceToken(_:)"},{"text":" ","type":"text"},{"text":"See methods in dedicated section below for more info.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"}]}],"hierarchy":{"paths":[["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/onfleetdriversdk.OnfleetDriver\/s8CopyableP","doc:\/\/onfleetdriversdk.OnfleetDriver\/s9EscapableP","doc:\/\/onfleetdriversdk.OnfleetDriver\/s8SendableP","doc: