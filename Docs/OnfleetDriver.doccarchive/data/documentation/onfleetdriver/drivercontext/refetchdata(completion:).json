{"sections":[],"metadata":{"externalID":"s:13OnfleetDriver0B7ContextC11refetchData10completionyys6ResultOyytAA05FetchE5ErrorOGcSg_tF","modules":[{"name":"OnfleetDriver"}],"extendedModule":"OnfleetDriver","role":"symbol","roleHeading":"Instance Method","title":"refetchData(completion:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refetchData","kind":"identifier"},{"text":"(","kind":"text"},{"text":"completion","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"FetchDataHandler","preciseIdentifier":"s:13OnfleetDriver0B7ContextC16FetchDataHandlera","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext"]]},"kind":"symbol","identifier":{"url":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/refetchData(completion:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Fetches all data from remote server."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refetchData","kind":"identifier"},{"text":"(","kind":"text"},{"text":"completion","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/FetchDataHandler","text":"FetchDataHandler","kind":"typeIdentifier","preciseIdentifier":"s:13OnfleetDriver0B7ContextC16FetchDataHandlera"},{"text":"?)","kind":"text"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Data fetching works semi-automatically. SDK fetches data from remove server as needed and there is no need","type":"text"},{"text":" ","type":"text"},{"text":"to do any custom data fetching logic except when there is an error or data becomes stale. Host app can","type":"text"},{"text":" ","type":"text"},{"text":"implement manual fetching mechanism like pull to refresh or similar, see","type":"text"},{"text":" ","type":"text"},{"code":"DriverContext.refetchData(completion:)","type":"codeVoice"},{"text":" to refetch data any time .","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"After some time data can become stale, for example if there is no internet for a while. See ","type":"text"},{"code":"isDataStale","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or observe ","type":"text"},{"code":"dataState","type":"codeVoice"},{"text":" for changes. SDK can fetch data any time and if you wish to observe this event","type":"text"},{"text":" ","type":"text"},{"text":"you can subscribe to ","type":"text"},{"code":"fetchingState","type":"codeVoice"},{"text":". It is a good practice to show in UI that data is stale, failed","type":"text"},{"text":" ","type":"text"},{"text":"fetching or being fetched.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Calling this method multiple times does not trigger multiple data fetch operations. Instead, completion","type":"text"},{"text":" ","type":"text"},{"text":"block will be captured and called once the operation is complete.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/onfleetdriver\/drivercontext\/refetchdata(completion:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://onfleetdriversdk.OnfleetDriver/documentation/OnfleetDriver/DriverContext":{"navigatorTitle":[{"text":"DriverContext","kind":"identifier"}],"abstract":[{"text":"Main SDK object that provides access to all services.","type":"text"}],"kind":"symbol","url":"\/documentation\/onfleetdriver\/drivercontext","title":"DriverContext","type":"topic","role":"symbol","fragments":[{"text":"c