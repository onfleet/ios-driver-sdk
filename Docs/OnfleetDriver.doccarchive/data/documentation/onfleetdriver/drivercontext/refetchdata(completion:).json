{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/refetchData(completion:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/onfleetdriver\/drivercontext\/refetchdata(completion:)"]}],"metadata":{"modules":[{"name":"OnfleetDriver"}],"extendedModule":"OnfleetDriver","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"refetchData"},{"kind":"text","text":"("},{"kind":"externalParam","text":"completion"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"FetchDataHandler","preciseIdentifier":"s:13OnfleetDriver0B7ContextC16FetchDataHandlera"},{"text":"?)","kind":"text"}],"roleHeading":"Instance Method","title":"refetchData(completion:)","symbolKind":"method","externalID":"s:13OnfleetDriver0B7ContextC11refetchData10completionyys6ResultOyytAA05FetchE5ErrorOGcSg_tF"},"hierarchy":{"paths":[["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refetchData","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"completion"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13OnfleetDriver0B7ContextC16FetchDataHandlera","kind":"typeIdentifier","text":"FetchDataHandler","identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/FetchDataHandler"},{"text":"?)","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Data fetching works semi-automatically. SDK fetches data from remove server as needed and there is no need"},{"type":"text","text":" "},{"type":"text","text":"to do any custom data fetching logic except when there is an error or data becomes stale. Host app can"},{"type":"text","text":" "},{"type":"text","text":"implement manual fetching mechanism like pull to refresh or similar, see"},{"type":"text","text":" "},{"code":"DriverContext.refetchData(completion:)","type":"codeVoice"},{"text":" to refetch data any time .","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"After some time data can become stale, for example if there is no internet for a while. See ","type":"text"},{"type":"codeVoice","code":"isDataStale"},{"text":" ","type":"text"},{"text":"or observe ","type":"text"},{"type":"codeVoice","code":"dataState"},{"text":" for changes. SDK can fetch data any time and if you wish to observe this event","type":"text"},{"text":" ","type":"text"},{"text":"you can subscribe to ","type":"text"},{"type":"codeVoice","code":"fetchingState"},{"text":". It is a good practice to show in UI that data is stale, failed","type":"text"},{"text":" ","type":"text"},{"text":"fetching or being fetched.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Calling this method multiple times does not trigger multiple data fetch operations. Instead, completion","type":"text"},{"text":" ","type":"text"},{"text":"block will be captured and called once the operation is complete.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"text":"Fetches all data from remote server.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://onfleetdriversdk.OnfleetDriver/documentation/OnfleetDriver/DriverContext/refetchData(completion:)":{"role":"symbol","type":"topic","title":"refetchData(completion:)","identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/refetchData(completion:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refetc