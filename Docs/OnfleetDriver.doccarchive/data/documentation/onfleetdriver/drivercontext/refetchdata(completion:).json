{"kind":"symbol","abstract":[{"type":"text","text":"Fetches all data from remote server."}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"refetchData"},{"kind":"text","text":"("},{"kind":"externalParam","text":"completion"},{"kind":"text","text":": "},{"identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/FetchDataHandler","preciseIdentifier":"s:13OnfleetDriver0B7ContextC16FetchDataHandlera","kind":"typeIdentifier","text":"FetchDataHandler"},{"kind":"text","text":"?)"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Data fetching works semi-automatically. SDK fetches data from remove server as needed and there is no need"},{"type":"text","text":" "},{"type":"text","text":"to do any custom data fetching logic except when there is an error or data becomes stale. Host app can"},{"type":"text","text":" "},{"type":"text","text":"implement manual fetching mechanism like pull to refresh or similar, see"},{"type":"text","text":" "},{"code":"DriverContext.refetchData(completion:)","type":"codeVoice"},{"type":"text","text":" to refetch data any time ."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After some time data can become stale, for example if there is no internet for a while. See "},{"code":"isDataStale","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or observe "},{"code":"dataState","type":"codeVoice"},{"type":"text","text":" for changes. SDK can fetch data any time and if you wish to observe this event"},{"type":"text","text":" "},{"type":"text","text":"you can subscribe to "},{"code":"fetchingState","type":"codeVoice"},{"type":"text","text":". It is a good practice to show in UI that data is stale, failed"},{"type":"text","text":" "},{"type":"text","text":"fetching or being fetched."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling this method multiple times does not trigger multiple data fetch operations. Instead, completion"},{"type":"text","text":" "},{"type":"text","text":"block will be captured and called once the operation is complete."}]}],"kind":"content"}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"refetchData"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"completion"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:13OnfleetDriver0B7ContextC16FetchDataHandlera","text":"FetchDataHandler"},{"kind":"text","text":"?)"}],"symbolKind":"method","extendedModule":"OnfleetDriver","roleHeading":"Instance Method","externalID":"s:13OnfleetDriver0B7ContextC11refetchData10completionyys6ResultOyytAA05FetchE5ErrorOGcSg_tF","title":"refetchData(completion:)","modules":[{"name":"OnfleetDriver"}],"role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/refetchData(completion:)"},"hierarchy":{"paths":[["doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver","doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/onfleetdriver\/drivercontext\/refetchdata(completion:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://onfleetdriversdk.OnfleetDriver/documentation/OnfleetDriver/DriverContext/refetchData(completion:)":{"kind":"symbol","abstract":[{"type":"text","text":"Fetches all data from remote server."}],"identifier":"doc:\/\/onfleetdriversdk.OnfleetDriver\/documentation\/OnfleetDriver\/DriverContext\/refetchData(completion:)","type":"topic","url":"\/documentation\/onfleetdriver\/drivercon